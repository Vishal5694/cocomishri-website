# Show temporary Unsplash sample photos in production builds (preview only)
NEXT_PUBLIC_SHOW_SAMPLE_IMAGES=false

# Base path for deployment (e.g. /cocomishri-website on GitHub Pages, empty for local/Vercel)
NEXT_PUBLIC_BASE_PATH=

# Enable dev-only Section Customizer side panel (never set to true on live production server)
NEXT_PUBLIC_ENABLE_CUSTOMIZER=false
